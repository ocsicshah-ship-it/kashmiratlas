# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=kashmiratlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Used by the API and pipeline. Inside docker-compose the host is `postgis`.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/kashmiratlas

# ── API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed by CORS (the frontend dev server).
API_CORS_ORIGINS=http://localhost:3000

# ── Frontend (NEXT_PUBLIC_* are exposed to the browser) ──────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Free tier: https://cloud.maptiler.com  (basemap for 2.5D mode)
NEXT_PUBLIC_MAPTILER_KEY=
# Free tier: https://cesium.com/ion       (world terrain for 3D mode)
NEXT_PUBLIC_CESIUM_ION_TOKEN=
