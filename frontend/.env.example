# Copy to frontend/.env.local. NEXT_PUBLIC_* are exposed to the browser.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Free tier: https://cloud.maptiler.com  (basemap for 2.5D mode; falls back to a
# free demo style if blank)
NEXT_PUBLIC_MAPTILER_KEY=
# Free tier: https://cesium.com/ion  (world terrain for 3D mode; falls back to a
# flat ellipsoid if blank)
NEXT_PUBLIC_CESIUM_ION_TOKEN=
